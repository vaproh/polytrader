# copy to .env  and  chmod 600 .env
#
# PK = the key that SIGNS orders. Never share it, never commit it.
PK=

# The address that HOLDS your funds.
#   - Polymarket proxy/deposit wallet -> paste that address
#   - plain MetaMask EOA              -> leave empty; the signer is used
# The SDK derives the wallet type from these two; no signature type needed.
POLY_FUNDER=

# OPTIONAL ceiling per order, in USDC. Leave empty for no cap.
# If set, the broker refuses anything above it.
POLY_MAX_USDC=
